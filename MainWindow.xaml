<Window x:Class="GameManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameManager"
        mc:Ignorable="d"
        Title="游戏管理工具" MaxHeight="512" MaxWidth="876" MinHeight="512" MinWidth="876"
        UseLayoutRounding="True"
        >
    <Grid>
        <TabControl>
            <TabItem Header="启动">
                <Grid Background="#FFE5E5E5">
                    <Button x:Name="Start_the_Fucking_Game" Content="启动该游戏" HorizontalAlignment="Left"  FontSize="20" Margin="101,277,0,0" VerticalAlignment="Top" Width="320" Height="48" IsEnabled="False" Click="Start_the_Fucking_Game_Click"/>
                    <Label x:Name="The_Game_Info" FontSize="50" HorizontalAlignment="Center" Content="请先到游戏库选择一款游戏" Margin="0,150,0,207" />
                    <Button x:Name="Close_the_Fucking_Game" Content="强制结束游戏" Background="Red" HorizontalAlignment="Left" Margin="458,277,0,0" FontSize="20" VerticalAlignment="Top" Width="320" Height="48" IsEnabled="False" Click="Close_the_Fucking_Game_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="游戏库">
                <Grid Background="#FFE5E5E5" Margin="0,1,0,-1">
                    <TextBlock Text="选择一款游戏" FontSize="20" Margin="75,36,417,319" />
                    <Button x:Name="Fuck_Confirm_Game" Content="确定" HorizontalAlignment="Left" Margin="687,352,0,0" VerticalAlignment="Top" Width="145" Height="42" IsEnabled="False"/>
                    <ComboBox x:Name="Choice_The_Fucking_Game"  HorizontalAlignment="Left" SelectionChanged="Choice_SelectionChanged" Margin="75,95,0,0" VerticalAlignment="Top" Width="325" Height="43"/>
                    <TextBlock Text="你没有游戏？添加一个" FontSize="20" Margin="72,175,420,188" />
                    <TextBox x:Name="Game_Name" HorizontalAlignment="Left" Margin="72,246,0,0" Text="输入你的游戏名称" VerticalAlignment="Top" Width="280" Height="38"/>
                    <Button x:Name="Add_Fucking_Game" Content="添加" HorizontalAlignment="Left" Margin="72,349,0,0" VerticalAlignment="Top" Width="215" Height="38" Click="add_Game"/>
                    <Button x:Name="Delete_Game_btn" Content="删除" HorizontalAlignment="Left" Margin="312,349,0,0" VerticalAlignment="Top" Height="38" Width="126" Click="Delete_Game_btn_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="设置">
                <Grid>

                    <Grid>
                        <TextBlock Width="300" VerticalAlignment="Top"  x:Name="Version_Info" HorizontalAlignment="Left" Text="版本号读取错误" FontSize="20" Margin="25,110,0,0"/>
                        <Button x:Name="Update_Version" Content="检查更新" HorizontalAlignment="Left"  VerticalAlignment="Top" Width="144" Height="42" Click="Update_Version_Click" Margin="25,193,0,0"/>
                        <TextBlock Text="开发者：Commkom" Width="200" FontSize="20" VerticalAlignment="Top" Margin="25,70,651,0"/>
                        <TextBlock Width="848" VerticalAlignment="Top"  x:Name="Github" HorizontalAlignment="Left" Text="Github链接：https://github.com/12Com-A/GameManager" FontSize="20" Margin="25,150,0,0"/>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
